# systemd *user* unit for the taskmgr scheduler daemon (no root needed).
#
# `task create host` writes this unit for you. By hand:
#   python3 -m taskmgr.pyz -o dist                                   # on your machine
#   ssh SERVER mkdir -p .taskmgr-remote/versions
#   scp dist/taskmgr-remote.pyz SERVER:.taskmgr-remote/versions/<version>.pyz
#   ln -s versions/<version>.pyz ~/.taskmgr-remote/taskmgr-remote.pyz   # on the server
#   mkdir -p ~/.config/systemd/user
#   cp taskmgr-remote.user.service ~/.config/systemd/user/taskmgr-remote.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now taskmgr-remote
#   loginctl enable-linger "$USER"   # keep the user manager (and tasks) alive without a login
#
# ExecStart names python3 by its absolute path, like the unit `task create host` writes: use
# the output of `command -v python3` in an ssh session (Python 3.10 or newer), so the
# service runs the Python you checked, whatever PATH the user manager has.
#
# %h is the user's home directory. remote_root (~/.taskmgr-remote) holds config.json, the job
# data and the code. It must be on a local filesystem; if $HOME is on NFS, use a directory
# on local disk (e.g. /scratch/<user>/taskmgr-remote) in both places of ExecStart.
#
# KillMode=process: `systemctl --user stop/restart` signals only the daemon's main process.
# Shims run in their own sessions but stay in this unit's cgroup, so the default
# KillMode=control-group would kill every shim and task. The daemon handles SIGTERM by
# exiting without touching shims or tasks; on start it recovers state (Section 12.2).
[Unit]
Description=taskmgr remote scheduler daemon (user service)

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/.taskmgr-remote/taskmgr-remote.pyz --root %h/.taskmgr-remote serve
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
